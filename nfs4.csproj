<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.3</Version>
        <OutputType>Exe</OutputType>
        <OutputType Condition="'$(NoConsole)' == 'true'">WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>nfs4</AssemblyName>
        <CETCompat>false</CETCompat>
        <NoWarn>$(NoWarn);CS0164;CS0162;CS0219</NoWarn>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <DefaultItemExcludes>$(DefaultItemExcludes);external\**;build\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="icon.ico" LogicalName="icon.ico"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="external\RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="mods\**"/>
        <None Include="mods\**" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="packs\**" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
